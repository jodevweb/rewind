{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REWIND",
  "version": "0.1.0",
  "identifier": "com.danim.rewind",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5274",
    "beforeDevCommand": "pnpm vite --port 5274",
    "beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "REWIND",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "copyright": "REWIND",
    "shortDescription": "Une mémoire contextuelle pour ton ordinateur",
    "longDescription": "REWIND comprend sur quoi tu travailles, même quand ton travail traverse plusieurs applications. Local-first : rien ne quitte ta machine.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "exceptionDomain": "",
      "entitlements": null,
      "files": {}
    },
    "category": "Productivity",
    "publisher": "Danim"
  }
}
