{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REWIND",
  "version": "0.1.0",
  "identifier": "io.github.jodevweb.rewind",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5274",
    "beforeDevCommand": "pnpm --filter @rewind/mcp bundle && pnpm run frontend:dev",
    "beforeBuildCommand": "pnpm --filter @rewind/mcp bundle && pnpm run frontend:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "REWIND",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "resources": { "resources/mcp/*": "mcp/" },
    "icon": ["icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "copyright": "REWIND",
    "shortDescription": "Une mémoire contextuelle pour ton ordinateur",
    "longDescription": "REWIND comprend sur quoi tu travailles, même quand ton travail traverse plusieurs applications. Local-first : rien ne quitte ta machine.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "exceptionDomain": "",
      "entitlements": null,
      "files": {}
    },
    "category": "Productivity",
    "publisher": "jodevweb"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEM0QzRUIxQTMyM0NBNDAKUldSQXlpT2pzVDQ5emRJMDhJME92SnVNcEVUTWEySlBobVpGdU5NSHVoWXpRd09VM1NkVnNUeW0K",
      "endpoints": ["https://github.com/jodevweb/rewind/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
