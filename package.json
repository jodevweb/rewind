{
  "name": "rewind",
  "version": "0.0.0",
  "private": true,
  "description": "REWIND — a context memory for your computer. Local-first, event-first.",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @rewind/studio dev",
    "capture": "pnpm --filter @rewind/capture-probe capture",
    "capture:clear": "pnpm --filter @rewind/capture-probe capture:clear",
    "eval": "pnpm --filter @rewind/eval eval",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "codegen": "turbo run codegen",
    "build:fixtures": "pnpm --filter @rewind/fixtures build",
    "check:forbidden-apis": "node scripts/check-forbidden-apis.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:forbidden-apis"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
