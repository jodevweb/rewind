{
  "name": "@rewind/eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Context engine evaluation harness: pairwise grouping, false merge/split, purity, coverage. Engine-agnostic — it scores a prediction file.",
  "main": "./src/index.ts",
